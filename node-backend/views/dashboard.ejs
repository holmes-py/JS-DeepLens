<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JS DeepLens — <%= projectName %></title>
    <meta name="description" content="JavaScript Analysis Dashboard for Security Researchers">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- Prism Theme (Okaidia for dark) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-okaidia.min.css">
    
    <!-- Main Styles -->
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body data-initial-offset="<%= initialOffset %>" data-initial-has-more="<%= initialHasMore %>" data-llm-enabled="<%= isLLMEnabled %>">
    
    <!-- ========== HEADER ========== -->
    <header>
        <h1>
            JS DEEPLENS
            <span class="project-name"><%= projectName %></span>
        </h1>
        <div class="stats">
            <div>Processed <span id="requests-processed"><%= initialStats.requestsProcessedByExtension %></span></div>
            <div>JS Files <span id="js-received"><%= initialStats.jsFilesReceivedForAnalysis %></span></div>
            <div>Scripts <span id="total-findings"><%= initialStats.totalFindings %></span></div>
            <div><span id="connection-status" class="connecting">Connecting</span></div>
        </div>
    </header>

    <!-- ========== MAIN CONTENT ========== -->
    <div class="content-wrapper">
        <main id="main-content-area">
            
            <!-- Settings Panels -->
            <div class="settings-container">
                
                <!-- Scope Configuration -->
                <details class="settings-details">
                    <summary>Scope Configuration</summary>
                    <div class="settings-content">
                        <div class="settings-section">
                            <label for="include-regex">Include URLs (Regex, one per line)</label>
                            <textarea id="include-regex" rows="3" placeholder=".* (include all by default)"></textarea>
                        </div>
                        <div class="settings-section">
                            <label for="exclude-regex">Exclude URLs (Regex, one per line)</label>
                            <textarea id="exclude-regex" rows="3" placeholder="google-analytics\.com&#10;sentry\.io"></textarea>
                        </div>
                        <div class="button-group">
                            <button id="save-scope-button" class="action-button save-button">Save Scope</button>
                        </div>
                        <div id="scope-feedback" class="feedback"></div>
                    </div>
                </details>
                
                <!-- Pattern Selection -->
                <details class="settings-details">
                    <summary>Pattern Selection</summary>
                    <div class="settings-content">
                        <div class="settings-section">
                            <label>Select regex patterns for analysis</label>
                            <div id="pattern-list-container" class="pattern-list">
                                <div class="spinner"></div> Loading patterns...
                            </div>
                        </div>
                        <div class="button-group">
                            <button id="rescan-button" class="action-button" title="Re-scan all saved JS using selected patterns">Re-scan Project</button>
                            <button id="save-patterns-button" class="action-button save-button">Save Selection</button>
                        </div>
                        <div id="patterns-feedback" class="feedback"></div>
                        <div id="rescan-status"></div>
                    </div>
                </details>
                
            </div>
            
            <!-- Table Actions -->
            <div class="table-actions">
                <button id="analyze-selected-button" class="action-button analyze-button" <%= !isLLMEnabled ? 'disabled' : '' %> title="<%= isLLMEnabled ? 'Analyze selected scripts with LLM' : 'LLM is disabled' %>">
                    Analyze Selected (<span id="selected-count">0</span>) with LLM
                </button>
                <% if (!isLLMEnabled) { %>
                    <span style="font-size: 0.85rem; color: var(--text-muted); font-style: italic;">LLM disabled — set GEMINI_API_KEY</span>
                <% } %>
            </div>
            
            <!-- Findings Table -->
            <div class="table-container" id="table-scroll-container">
                <div id="loading-overlay" class="loading-overlay">
                    <div class="spinner"></div>
                    Analyzing with LLM...
                </div>
                
                <table>
                    <thead>
                        <tr>
                            <th class="id-col sortable" id="sort-by-id">ID</th>
                            <th class="select-col">
                                <input type="checkbox" id="select-all-checkbox" title="Select/Deselect All">
                            </th>
                            <th class="ts-col">First Seen</th>
                            <th class="url-col">URL</th>
                            <th class="source-col">Analysis</th>
                            <th class="actions-col">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="findingsTableBody">
                        <% if (findings.length === 0) { %>
                            <tr id="no-findings-row">
                                <td colspan="6" class="no-findings">
                                    No scripts found for project '<%= projectName %>'. Waiting for data...
                                </td>
                            </tr>
                        <% } else { %>
                            <% findings.forEach(function(script) { %>
                                <!-- Finding Row -->
                                <tr class="finding-row" data-finding-id="<%= script.id %>" data-url="<%= script.url %>" data-content-hash="<%= script.content_hash || '' %>">
                                    <td class="id-col">#<%= script.id %></td>
                                    <td class="select-col">
                                        <input type="checkbox" class="row-checkbox" value="<%= script.id %>">
                                    </td>
                                    <td class="ts-col"><%= new Date(script.timestamp).toLocaleString() %></td>
                                    <td class="url-col" title="<%= script.url %>"><%= script.url %></td>
                                    <td class="source-col">
                                        <% if (Array.isArray(script.analysis_summary) && script.analysis_summary.length > 0) { %>
                                            <code><%= script.analysis_summary.length %></code> finding<%= script.analysis_summary.length !== 1 ? 's' : '' %>
                                        <% } else { %>
                                            <span style="color: var(--text-muted);">No matches</span>
                                        <% } %>
                                        <% if (script.has_sourcemap) { %>
                                            <span class="sourcemap-tag" title="Source map detected">MAP</span>
                                        <% } %>
                                    </td>
                                    <td class="actions-col">
                                        <button class="view-js-button action-button view-button" data-content-hash="<%= script.content_hash || '' %>" title="View JS Source" <% if (!script.content_hash) { %>disabled<% } %>>JS</button>
                                        <button class="run-ast-button action-button ast-button" data-finding-id="<%= script.id %>" title="Run AST Analysis" <% if (!script.content_hash) { %>disabled<% } %>>AST</button>
                                        <div class="llm-dropdown">
                                            <button class="action-button analyze-button llm-dropdown-button" data-finding-id="<%= script.id %>" <%= !isLLMEnabled || !script.content_hash ? 'disabled' : '' %> title="<%= isLLMEnabled && script.content_hash ? 'LLM Analysis' : (!isLLMEnabled ? 'LLM disabled' : 'No content') %>">
                                                LLM ▾
                                            </button>
                                            <div class="llm-dropdown-content">
                                                <button class="llm-action-button" data-action="default" data-finding-id="<%= script.id %>" <%= !isLLMEnabled || !script.content_hash ? 'disabled' : '' %>>Analyze (Default)</button>
                                                <button class="llm-action-button" data-action="with_ast" data-finding-id="<%= script.id %>" <%= !isLLMEnabled || !script.content_hash ? 'disabled' : '' %> title="Runs AST first, then LLM">Analyze with AST</button>
                                                <button class="llm-action-button" data-action="modify_prompt" data-finding-id="<%= script.id %>" <%= !isLLMEnabled || !script.content_hash ? 'disabled' : '' %>>Custom Prompt...</button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                
                                <!-- Details Row -->
                                <tr class="details-row" id="details-row-<%= script.id %>">
                                    <td colspan="6" class="details-cell">
                                        
                                        <!-- Regex Matches Section -->
                                        <div class="details-section" id="regex-matches-<%= script.id %>">
                                            <h4>Regex Matches</h4>
                                            <div class="details-content">
                                                <% if (Array.isArray(script.analysis_summary) && script.analysis_summary.length > 0) { %>
                                                    <ul>
                                                        <% script.analysis_summary.forEach(function(match) { %>
                                                            <li>
                                                                <strong>File:</strong> <code><%- match.sf %></code><br>
                                                                <strong>Pattern:</strong> <code><%- match.p %></code><br>
                                                                <strong>Match:</strong>
                                                                <pre><code><%- match.m %></code></pre>
                                                            </li>
                                                        <% }); %>
                                                    </ul>
                                                <% } else { %>
                                                    <p style="color: var(--text-muted); margin: 0;">No regex matches found with current patterns.</p>
                                                <% } %>
                                            </div>
                                        </div>
                                        
                                        <!-- AST Results Section -->
                                        <div class="details-section" id="ast-details-<%= script.id %>" style="display: none;">
                                            <h4>AST Results</h4>
                                            <div class="details-content loading">
                                                <span>Run AST analysis to see results.</span>
                                            </div>
                                        </div>
                                        
                                        <!-- LLM Results Section -->
                                        <div class="details-section" id="llm-details-<%= script.id %>" style="display: none;">
                                            <h4>LLM Results</h4>
                                            <div class="details-content loading">
                                                <div class="spinner"></div>
                                                <span>Awaiting LLM analysis...</span>
                                            </div>
                                        </div>
                                        
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
                
                <!-- Show More -->
                <div id="show-more-container">
                    <button id="show-more-button" class="action-button" <%= !initialHasMore ? 'style="display:none;"' : '' %>>
                        Load More
                    </button>
                    <span id="no-more-findings" style="display: <%= initialHasMore ? 'none' : 'inline' %>;">
                        All scripts loaded
                    </span>
                </div>
            </div>
            
        </main>

        <!-- ========== SIDE PANE (Code Viewer) ========== -->
        <aside id="side-pane">
            <div class="side-pane-header">
                <span id="side-pane-title" class="side-pane-title">JavaScript Source</span>
                <div class="side-pane-controls">
                    <label title="Toggle line wrapping">
                        <input type="checkbox" id="wrap-lines-checkbox"> Wrap
                    </label>
                    <button id="close-side-pane-button" title="Close Panel">&times;</button>
                </div>
            </div>
            <div id="side-pane-content">
                <div class="loading-placeholder">
                    <div class="spinner"></div>
                    <span>Loading...</span>
                </div>
                <pre style="display:none;"><code id="side-pane-code" class="language-js"></code></pre>
            </div>
        </aside>
    </div>

    <!-- ========== LLM PROMPT MODAL ========== -->
    <div id="llm-prompt-modal" class="modal-overlay">
        <div class="modal-content">
            <h3>Custom LLM Prompt</h3>
            <input type="hidden" id="modal-finding-id">
            <label for="llm-prompt-textarea">Edit the prompt before sending:</label>
            <textarea id="llm-prompt-textarea" rows="12" placeholder="Loading default prompt..."></textarea>
            <div id="modal-feedback" class="feedback"></div>
            <div class="modal-actions">
                <button id="modal-cancel-button" class="action-button">Cancel</button>
                <button id="modal-send-button" class="action-button analyze-button">Send to LLM</button>
            </div>
        </div>
    </div>

    <!-- ========== SCRIPTS ========== -->
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
    <script src="/js/script.js" defer></script>
</body>
</html>